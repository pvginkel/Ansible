import org.jenkinsci.plugins.pipeline.modeldefinition.Utils

library identifier: 'JenkinsPipelineUtils', changelog: false

podTemplate(inheritFrom: 'jenkins-agent kaniko') {
    node(POD_LABEL) {
        stage('Cloning repo') {
            // checkout scm populates currentBuild.changeSets, which is what
            // imageBuildRequired() reads.
            checkout scm
        }

        stage('Building iac image') {
            if (imageBuildRequired()) {
                container('kaniko') {
                    helmCharts.kaniko('support/iac-image/Dockerfile', '.', [
                        "registry:5000/iac:${currentBuild.number}",
                        "registry:5000/iac:latest"
                    ])
                }
            } else {
                Utils.markStageSkippedForConditional('Building iac image')
            }
        }
    }
}

def imageBuildRequired() {
    // A build whose changeset holds no file at all was not started by a push. In
    // practice that is the version poller's weekly rebuild, which triggers this job
    // with no commits and no parameters (the positional helmCharts.kaniko cannot
    // stamp the poller's params label); a hand-started build with no new commits
    // since the last one lands here too, and rebuilding is the wanted answer for
    // both. Only a push of the image advances its
    // org.webathome.poller.rebuild-at label, and the poller neither re-fires while
    // that value is unchanged nor triggers at all once it goes stale — so a rebuild
    // skipped here is never retried, and the image's floating ubuntu/apt/helm layers
    // stop being patched.
    if (!utils.hasChanges('.*')) {
        return true
    }

    // Everything support/iac-image/Dockerfile builds from: the build context under
    // support/iac-image/, the root poetry project baked in at :11, and the two files
    // copied out of ansible/ at :72 and :142. Every other COPY comes from the build
    // stage or a pinned external image. This file is watched too — it carries the
    // Dockerfile path, the context and both destination tags. utils.hasChanges tests
    // a changed file's whole repo-relative path with Groovy's ==~, so each pattern is
    // a full-match regex and a directory prefix carries a trailing /.*.
    return (
        utils.hasChanges('Jenkinsfile\\.iac-image') ||
        utils.hasChanges('support/iac-image/.*') ||
        utils.hasChanges('pyproject\\.toml') ||
        utils.hasChanges('poetry\\.lock') ||
        utils.hasChanges('ansible/roles/baseline/files/homelab-root\\.crt') ||
        utils.hasChanges('ansible/files/known_hosts\\.d/homelab')
    )
}
