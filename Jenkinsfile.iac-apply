// Converges prd, started by hand: plans, checks and applies Terraform's prd root, then runs the
// site playbook on every host outside iac_agent, site-openbao, and site-k8s on k8s prd. When
// srvk8sdev is up, it converges that too (site-k8s and site-ceph).
//
// A push to main only validates (Jenkinsfile.iac-on-push); converging prd is a deliberate act
// someone starts. The prd stages run in order and the first that fails ends the build. The dev
// stage can only mark the build UNSTABLE.
//
// The plan and the destroy check are repeated here rather than trusted from the validate run:
// check-protected-vms.sh is the guard that stops an apply destroying a prd VM, and a guard that
// runs in a different build against a different commit is not a guard. For the same reason the
// plan, the check and the apply of that saved plan share one `iac` call, since every `iac` call is
// a fresh container and clone, and a second call would plan again.
//
// Every playbook runs with `--skip-tags os_update`: the apt cache refresh and dist-upgrade are
// patch posture, owned by Jenkinsfile.iac-scheduled-update. This job converges config drift only;
// it never drains, upgrades or reboots a cluster node.
//
// Controller config:
//   - Job: IaC/Apply
//   - SCM: pvginkel/Ansible, branch main
//   - Script Path: Jenkinsfile.iac-apply

library identifier: 'JenkinsPipelineUtils', changelog: false

// srvk8sdev is off unless someone starts it by hand. `-T 5` caps the connect,
// so a down box costs seconds rather than a playbook's worth of connection retries (or microk8s'
// "wait for API" loop).
def devUp() {
    return sh(
        returnStatus: true,
        script: '''
            iac -c '
                cd /work/Ansible/ansible
                ansible k8s_dev -m ping -T 5
            '
        '''
    ) == 0
}

pipeline {
    agent { label 'iac-controller' }

    options {
        // Without abortPrevious: an abort in the middle of an apply leaves prd half converged.
        disableConcurrentBuilds()
        skipDefaultCheckout()
        timeout(time: 4, unit: 'HOURS')
        timestamps()
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        // The plan file stays inside the iac container: a saved plan holds the secret values it
        // would write.
        stage('Apply Terraform (prd)') {
            steps {
                sh '''
                    iac -c '
                        set -euo pipefail
                        cd /work/Ansible/terraform/prd
                        terraform init -input=false -no-color
                        rc=0
                        terraform plan -out=/tmp/plan.tfplan -no-color -detailed-exitcode || rc=$?
                        # POSIX test, not [[ ]]: iac -c runs the script under
                        # the iac image sh (dash), where [[ is "not found".
                        if [ "$rc" -ne 0 ] && [ "$rc" -ne 2 ]; then exit "$rc"; fi
                        terraform show -json /tmp/plan.tfplan > /tmp/plan.json
                        check-protected-vms.sh /tmp/plan.json
                        terraform apply -input=false -no-color /tmp/plan.tfplan
                    '
                '''
            }
        }

        stage('Apply site (excl. iac_agent)') {
            steps {
                sh '''
                    iac -c '
                        set -euo pipefail
                        cd /work/Ansible/ansible
                        ansible-playbook --diff playbooks/site.yml --limit "!iac_agent" --skip-tags os_update
                    '
                '''
            }
        }

        // site.yml excludes the OpenBao service VMs because the pre-cert known_hosts handoff for
        // srvvaultN lives in site-openbao.yml's Play 0. Play 0 reads `terraform output
        // host_pubkeys` and writes tmp/known_hosts.openbao at run time, so this runs from CI
        // without operator priming.
        stage('Apply site-openbao') {
            steps {
                sh '''
                    iac -c '
                        set -euo pipefail
                        cd /work/Ansible/ansible
                        ansible-playbook --diff playbooks/site-openbao.yml --skip-tags os_update
                    '
                '''
            }
        }

        // site.yml excludes the k8s groups because a cluster change needs serial: 1, so without
        // this stage a microk8s role change would not land. Limiting the play to one cluster is
        // safe: elect-primary elects per cluster.
        stage('Apply site-k8s (k8s prd)') {
            steps {
                sh '''
                    iac -c '
                        set -euo pipefail
                        cd /work/Ansible/ansible
                        ansible-playbook --diff playbooks/site-k8s.yml --limit k8s_prd --skip-tags os_update
                    '
                '''
            }
        }

        // srvk8sdev converges apart from prd, so a dev box that is powered off or broken never
        // blocks a prd deploy. site-ceph converges its microceph layer (ceph_dev is srvk8sdev only).
        // The shell bounds each playbook, not a `timeout` step: a `timeout` step that fires ends the
        // build ABORTED, which is how IaC/Apply #113 aborted with every prd stage green (srvk8sdev
        // answered SSH, then hung on `snap install microk8s`).
        stage('Apply site-k8s and site-ceph (srvk8sdev)') {
            steps {
                script {
                    if (!devUp()) {
                        unstable('srvk8sdev is unreachable — dev convergence skipped')
                        return
                    }
                    int rc = sh(
                        returnStatus: true,
                        script: '''
                            iac -c '
                                set -euo pipefail
                                cd /work/Ansible/ansible
                                timeout --kill-after=1m 10m ansible-playbook --diff playbooks/site-k8s.yml --limit k8s_dev --skip-tags os_update
                                timeout --kill-after=1m 10m ansible-playbook --diff playbooks/site-ceph.yml --skip-tags os_update
                            '
                        '''
                    )
                    if (rc != 0) {
                        String message = "dev convergence failed on srvk8sdev (exit ${rc})"
                        notify.warning(message)
                        unstable(message)
                    }
                }
            }
        }
    }

    post {
        aborted {
            script {
                notify.error("${env.JOB_NAME} #${env.BUILD_NUMBER} aborted (timeout or hand)")
            }
        }
    }
}
