// iac-scheduled-calico — weekly rolling-restart of the calico-node
// DaemonSet on the k8s clusters.
//
// Works around projectcalico/calico#8777: on long-uptime calico-node pods
// (worker nodes especially) the token_watch.go loop silently stops
// refreshing the CNI kubeconfig token; the bounded ServiceAccount token
// then expires and new pod sandboxes on that node fail with "error getting
// ClusterInformation: connection is unauthorized: Unauthorized". A weekly
// restart caps every calico-node pod's uptime below the stall window.
// Re-evaluate after each microk8s upgrade — see docs/runbooks/k8s-upgrade.md.
//
// Controller config:
//   - SCM: pvginkel/Ansible, branch main
//   - Script Path: Jenkinsfile.iac-scheduled-calico

library identifier: 'JenkinsPipelineUtils', changelog: false

// srvk8sdev is powered off most of the time. Every dev stage in every
// iac-* pipeline opens with this bounded SSH probe: `-T 5` caps the
// connect, so a down box costs seconds rather than a playbook's worth
// of connection retries. A false result means "skip the stage and mark
// the build UNSTABLE" — never FAILURE, and never a page.
def devUp() {
    return sh(
        returnStatus: true,
        script: '''
            iac -c '
                cd /work/Ansible/ansible
                ansible k8s_dev -m ping -T 5
            '
        '''
    ) == 0
}

pipeline {
    agent { label 'iac-controller' }

    triggers {
        // Weekly, mid-week and offset from the weekly OS-update roll so the
        // two never contend for the iac.lock, and a calico-node restart
        // lands between OS rolls. Cron lives here on purpose — the schedule
        // is part of the job and shouldn't hide in the controller's config.
        cron('H 4 * * 3')
    }

    options {
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '50'))
    }

    stages {
        // Critical cluster: a failed roll fails the build and pages.
        stage('k8s prd') {
            steps {
                sh '''
                    iac -c '
                        set -euo pipefail
                        cd /work/Ansible/ansible
                        ansible-playbook --diff playbooks/refresh-calico-token.yml --limit k8s_prd
                    '
                '''
            }
        }

        // Dev is single-node and often powered off: skip the roll when
        // it's unreachable, downgrade a real failure to UNSTABLE. Either
        // way the prd roll above owns the build's pass/fail.
        stage('k8s dev') {
            steps {
                script {
                    if (!devUp()) {
                        unstable('srvk8sdev is unreachable — dev calico roll skipped')
                        return
                    }
                    def rc = sh(
                        returnStatus: true,
                        script: '''
                            iac -c '
                                set -euo pipefail
                                cd /work/Ansible/ansible
                                timeout --kill-after=1m 15m ansible-playbook --diff playbooks/refresh-calico-token.yml --limit k8s_dev
                            '
                        '''
                    )
                    if (rc != 0) {
                        env.DEV_STAGE_FAILED = 'true'
                        unstable("dev calico roll failed on srvk8sdev (exit ${rc})")
                    }
                }
            }
        }
    }

    post {
        // No failure handler: jenkins-telegram-bot watches every build and
        // reports FAILURE loudly by itself, job name and build link included.
        // UNSTABLE it deliberately stays quiet about — an accepted warning is
        // exactly what unstable means — so a dev stage that genuinely broke
        // has to say so itself.
        unstable {
            // Page only when srvk8sdev was up and the roll genuinely
            // failed. An unreachable dev box yellows the build so it's
            // visible in Jenkins, but it isn't news.
            script {
                if (env.DEV_STAGE_FAILED == 'true') {
                    notify.warning('dev cluster roll failed on srvk8sdev')
                }
            }
        }
    }
}
