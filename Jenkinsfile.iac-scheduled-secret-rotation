// Rotates the OpenBao kv secrets that are due, every night, with SecretRotator's nightly run
// (AnsibleSpecs secret-rotation/design.md §8). It writes the new values to OpenBao and rolls them
// out to their consumers: Kubernetes workloads, Jenkins credentials and jobs, Ansible playbooks.
// It updates the standing YouTrack card and posts to Telegram. A dry run writes nothing but the
// card and the Telegram digest.
//
// SecretRotator is installed in the iac image from its prd branch (support/iac-image/Dockerfile),
// so this job clones nothing and installs nothing. Its credentials are srviac's SECRET_ROTATOR_*
// entries in /etc/iac/secrets.yaml, which iac-impl resolves. The switches (dry_run, paused,
// kinds_enabled, max_rotations_per_run) are committed in SecretRotator and ship in the image, so
// disabling this job is the immediate stop.
//
// The run posts every failed plan to Telegram itself. It exits non-zero only when the run itself
// broke, and only then is the build red.
//
// The IaC agent's single executor runs this job one at a time with the other IaC/* jobs. So a
// jenkins.job step that triggers an IaC/* job waits for this build's executor until the step's
// 30-minute bound fails it.
//
// Controller config:
//   - Job: IaC/Scheduled Secret Rotation
//   - SCM: pvginkel/Ansible, branch main
//   - Script Path: Jenkinsfile.iac-scheduled-secret-rotation

library identifier: 'JenkinsPipelineUtils', changelog: false

pipeline {
    agent { label 'iac-controller' }

    options {
        // Without abortPrevious: a build that ends in the middle of a plan, by an abort or by the
        // timeout, leaves kv/rotator/lock held and the plan stopped. Every night after that, the
        // run posts the lock's holder to Telegram and rotates nothing until the operator breaks the
        // lock in `secret-rotator run <path>` and resumes or aborts that plan there.
        disableConcurrentBuilds()
        skipDefaultCheckout()
        // The bound must outlast a plan's longest steps: a jenkins.job step waits up to 30 minutes
        // and an ansible.run up to 20, and a rollback runs the plan's activations again.
        timeout(time: 4, unit: 'HOURS')
        timestamps()
    }

    triggers {
        // Design §8 fixes the run at 05:30, after the last srvvault reboot window (srvvault3, 04:30),
        // so the minute is not H. The IaC agent's single executor runs the iac-controller jobs one at
        // a time anyway, so spreading them over the hour gains nothing.
        cron('30 5 * * *')
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Rotate secrets') {
            steps {
                sh '''
                    iac -c 'secret-rotator run'
                '''
            }
        }
    }

    post {
        aborted {
            script {
                notify.error("${env.JOB_NAME} #${env.BUILD_NUMBER} aborted (timeout or hand)")
            }
        }
    }
}
