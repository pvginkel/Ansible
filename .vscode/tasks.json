{
  // Runs on srviac: the rotator's identity, code and network position are there (design.md R17),
  // and it works when Kubernetes is down. SecretRotator is installed in the iac image from its prd
  // branch. `ssh -t` gives `iac` the TTY it needs to add `-it`, and `run` prompts on it. `sudo`
  // because only pvginkel is in srviac's docker group. No SSH options: the operator's login script
  // has the keys in ssh-agent, and the pod's known_hosts trusts the homelab SSH CA.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "secret-rotator ui (srviac)",
      "type": "shell",
      "command": "ssh",
      "args": [
        "-t",
        "ansible@srviac",
        "sudo iac -c 'secret-rotator ui'"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true,
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "secret-rotator run (srviac)",
      "type": "shell",
      "command": "ssh",
      "args": [
        "-t",
        "ansible@srviac",
        "sudo iac -c 'secret-rotator run ${input:secretRotatorLeaf}'"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true,
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "secret-rotator plan (srviac)",
      "type": "shell",
      "command": "ssh",
      "args": [
        "-t",
        "ansible@srviac",
        "sudo iac -c 'secret-rotator plan ${input:secretRotatorLeaf}'"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true,
        "clear": true
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "secretRotatorLeaf",
      "type": "promptString",
      "description": "The leaf, a path of the kv mount (e.g. iac/rotator-approle)"
    }
  ]
}
