// iac-scheduled-certs — weekly certificate renewal: the fleet's SSH host
// certificates and the internal_tls step-ca leaves.
//
// The homelab's whole host-key verification story rests on one
// `@cert-authority` line, and step-ca host certs live 47 days. Before
// this job existed nothing renewed them on a schedule: drift is
// --check-only and so structurally incapable of signing, the applying
// pipeline runs only when someone starts it and every prior stage is
// green (it fired on push to main back then; it is iac-apply, by hand,
// now), and srviac was excluded from both. In July 2026 that took
// srvk8s1, srvk8s2 and srviac off the network — including the Ansible
// controller's own host, which no pipeline had renewed since May.
//
// The internal_tls X.509 leaves — pveproxy on the PVE hosts, the
// kube-apiserver homelab SNI cert, the OpenBao listener — sit in the
// same hole for the same reasons: 47-day lifetime, 14-day renewal
// window, and outside this job they are signed only by a hand-started
// iac-apply. They renew here, and a red or unstable build of this job is
// the whole detector for a leaf renewal that stopped happening.
//
// Weekly against a 14-day renewal window means two attempts before any
// certificate lapses. Both playbooks are a no-op outside that window, so
// most runs are a fast changed=0.
//
// Deliberately NOT folded into iac-scheduled-update: coupling renewal
// to the drain/reboot roll would mean a wedged node blocks certificate
// renewal fleet-wide, which is a variant of how this broke in the first
// place. Certs get their own job and their own signal.
//
// Controller config:
//   - SCM: pvginkel/Ansible, branch main
//   - Script Path: Jenkinsfile.iac-scheduled-certs

library identifier: 'JenkinsPipelineUtils', changelog: false

// srvk8sdev is powered off most of the time. Every dev stage in every
// iac-* pipeline opens with this bounded SSH probe: `-T 5` caps the
// connect, so a down box costs seconds rather than a playbook's worth
// of connection retries. A false result means "skip the stage and mark
// the build UNSTABLE" — never FAILURE, and never a page.
def devUp() {
    return sh(
        returnStatus: true,
        script: '''
            iac -c '
                cd /work/Ansible/ansible
                ansible k8s_dev -m ping -T 5
            '
        '''
    ) == 0
}

pipeline {
    agent { label 'iac-controller' }

    triggers {
        // Friday morning: clear of the Sunday OS roll, the Wednesday
        // calico rollout and the daily 11:00 drift check, so this never
        // contends for the iac.lock. Cron lives here, in git, on
        // purpose — see the comment in Jenkinsfile.iac-scheduled-drift
        // for what happens when a schedule lives only in the UI.
        cron('H 4 * * 5')
    }

    options {
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '50'))
    }

    stages {
        // Everything except the dev k8s node. An expired certificate
        // makes a host unreachable to Ansible entirely, so a failure
        // here is genuinely urgent — it fails the build and pages.
        stage('Host certs (excl. k8s dev)') {
            steps {
                sh '''
                    iac -c '
                        set -euo pipefail
                        cd /work/Ansible/ansible
                        ansible-playbook --diff playbooks/renew-host-certs.yml --limit "!k8s_dev"
                    '
                '''
            }
            post {
                failure {
                    script {
                        currentBuild.description = 'host certs may lapse; TLS leaf renewal did not run'
                    }
                }
            }
        }

        // srvk8sdev is powered off most of the time. Same idiom as the
        // other pipelines: skip the stage when the box is down, and
        // downgrade a real failure to UNSTABLE, so a dev box never reds
        // a build that renewed prod correctly.
        //
        // A dev node that stays off past its 14-day window will lapse
        // and need reissue-host-cert.yml. That is the accepted cost of
        // a box that is off more than it is on.
        stage('Host certs (k8s dev)') {
            steps {
                script {
                    if (!devUp()) {
                        unstable('srvk8sdev is unreachable — dev host cert renewal skipped')
                        return
                    }
                    def rc = sh(
                        returnStatus: true,
                        script: '''
                            iac -c '
                                set -euo pipefail
                                cd /work/Ansible/ansible
                                timeout --kill-after=1m 10m ansible-playbook --diff playbooks/renew-host-certs.yml --limit k8s_dev
                            '
                        '''
                    )
                    if (rc != 0) {
                        env.DEV_STAGE_FAILED = 'true'
                        unstable("dev host cert renewal failed on srvk8sdev (exit ${rc})")
                    }
                }
            }
        }

        // The internal_tls leaves on the same scope: pveproxy on
        // pve/pve1/pve2, the kube-apiserver homelab SNI leaf on the prd
        // control planes, the OpenBao listener leaf on srvvault1/2/3. A
        // lapsed leaf breaks the Proxmox web UI, the kubernetes-api.home
        // SNI path and the OpenBao listener, so this fails the build and
        // pages too.
        //
        // The playbook renews every host it can before exiting non-zero,
        // so a partly-failed run reds this stage at the end of the run
        // rather than at the first bad host.
        //
        // No `timeout` bound: the reload phase is serialized one node at
        // a time and each prd control-plane node's kubelite restart
        // waits up to microk8s_kubelite_ready_timeout (180s), so a run
        // with all three k8s leaves due spends ~9 minutes in handlers
        // alone. A bound sized on the host-cert stage above would kill
        // such a run mid-roll, leaving a node's kubelite down.
        stage('TLS leaves (excl. k8s dev)') {
            steps {
                sh '''
                    iac -c '
                        set -euo pipefail
                        cd /work/Ansible/ansible
                        ansible-playbook --diff playbooks/renew-internal-tls.yml --limit "!k8s_dev"
                    '
                '''
            }
            post {
                failure {
                    script {
                        currentBuild.description = 'internal_tls leaves may lapse'
                    }
                }
            }
        }

        // Same dev handling as the host-cert stage: a powered-off box
        // skips and yellows, a genuine failure yellows and pages. The
        // operator picks the missed dev leaf up by hand with a manual
        // apply; this job does not carry it forward or retry it.
        //
        // 15m bound: one node, one leaf, and a kubelite restart that
        // waits up to 180s for this node to serve again.
        stage('TLS leaves (k8s dev)') {
            steps {
                script {
                    if (!devUp()) {
                        unstable('srvk8sdev is unreachable — dev TLS leaf renewal skipped')
                        return
                    }
                    def rc = sh(
                        returnStatus: true,
                        script: '''
                            iac -c '
                                set -euo pipefail
                                cd /work/Ansible/ansible
                                timeout --kill-after=1m 15m ansible-playbook --diff playbooks/renew-internal-tls.yml --limit k8s_dev
                            '
                        '''
                    )
                    if (rc != 0) {
                        env.DEV_STAGE_FAILED = 'true'
                        unstable("dev TLS leaf renewal failed on srvk8sdev (exit ${rc})")
                    }
                }
            }
        }
    }

    post {
        // jenkins-telegram-bot watches every build and reports FAILURE loudly
        // by itself, job name and build link included — so all a failure has
        // to add is what a red build of *this* job costs, which the bot
        // appends to that message from the description. The two classes of
        // certificate cost different things, so each prd stage writes its own
        // description rather than one handler guessing here. UNSTABLE the bot
        // deliberately stays quiet about — an accepted warning is exactly what
        // unstable means — so the dev stages say so themselves.
        unstable {
            // Page only when srvk8sdev was up and a renewal genuinely
            // failed; either dev stage sets the flag. A dev box that is
            // simply off yellows the build without pushing a
            // notification — its certificates lapsing is a known,
            // accepted consequence (see above). Which renewal failed is
            // in the stage's own unstable message.
            script {
                if (env.DEV_STAGE_FAILED == 'true') {
                    notify.warning('dev certificate renewal failed on srvk8sdev')
                }
            }
        }
    }
}
