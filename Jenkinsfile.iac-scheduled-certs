// Renews certificates every week: the fleet's SSH host certificates and the internal_tls step-ca
// leaves (pveproxy on the PVE hosts, the kube-apiserver homelab SNI cert, the OpenBao listener),
// on every host but srvk8sdev, then on srvk8sdev when it is up.
//
// The homelab's whole host-key verification story rests on one `@cert-authority` line, and step-ca
// host certs live 47 days. Drift is --check-only and cannot sign, and IaC/Apply runs only when
// someone starts it, so nothing else renews them on a schedule. In July 2026 that took srvk8s1,
// srvk8s2 and srviac off the network, the Ansible controller's own host included. The internal_tls
// leaves have the same 47-day lifetime and a 14-day renewal window. A red or unstable build of this
// job is the first detector for a renewal that stopped happening. The daily IaC/Scheduled Drift
// build is the second: it checks every leaf at 7 days, one period of this job shorter than the 14
// the role renews at, so it reds only once a Friday here has been missed.
//
// Weekly against a 14-day renewal window means two attempts before any certificate lapses. Both
// playbooks are a no-op outside that window, so most runs are a fast changed=0.
//
// Not folded into Jenkinsfile.iac-scheduled-update: coupling renewal to the drain and reboot roll
// would let a wedged node block certificate renewal fleet-wide. Certs get their own job and their
// own signal.
//
// Controller config:
//   - Job: IaC/Scheduled Certs
//   - SCM: pvginkel/Ansible, branch main
//   - Script Path: Jenkinsfile.iac-scheduled-certs

library identifier: 'JenkinsPipelineUtils', changelog: false

// srvk8sdev can be down: it starts with pve, but may be stopped by hand. `-T 5` caps the connect,
// so a down box costs seconds rather than a playbook's worth of connection retries.
def devUp() {
    return sh(
        returnStatus: true,
        script: '''
            iac -c '
                cd /work/Ansible/ansible
                ansible k8s_dev -m ping -T 5
            '
        '''
    ) == 0
}

// Runs a prd stage's playbook. jenkins-telegram-bot reports a FAILURE by itself and appends the
// build description to that message, so a non-zero exit appends `cost` to the build description,
// then marks the stage and the build FAILURE without throwing, so the stages after it still run.
// The sh stays outside catchError: an abort or a timeout() caught inside it sets the build ABORTED
// whatever buildResult says (IaC/Apply build #113).
def prdStage(String cost, String shellScript) {
    int rc = sh(returnStatus: true, script: shellScript)
    if (rc != 0) {
        if (currentBuild.description) {
            currentBuild.description = "${currentBuild.description}\n${cost}".toString()
        } else {
            currentBuild.description = cost
        }
        catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
            error("${env.STAGE_NAME} failed (exit ${rc})")
        }
    }
}

pipeline {
    agent { label 'iac-controller' }

    options {
        // Without abortPrevious: an abort in the middle of the TLS leaf roll can leave a k8s
        // node's kubelite down.
        disableConcurrentBuilds()
        skipDefaultCheckout()
        timeout(time: 4, unit: 'HOURS')
        timestamps()
    }

    triggers {
        // Friday morning: clear of the Sunday OS roll, the Wednesday calico rollout and the daily
        // 11:00 drift check.
        cron('H 4 * * 5')
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        // An expired certificate makes a host unreachable to Ansible entirely, so a failure here
        // fails the build and pages.
        stage('Renew host certs (excl. k8s dev)') {
            steps {
                script {
                    prdStage('host certs may lapse', '''
                        iac -c '
                            set -euo pipefail
                            cd /work/Ansible/ansible
                            ansible-playbook --diff playbooks/renew-host-certs.yml --limit "!k8s_dev"
                        '
                    ''')
                }
            }
        }

        // A dev node that stays off past its 14-day window lapses and needs reissue-host-cert.yml.
        // That is the accepted cost of letting a dev box be stopped.
        stage('Renew host certs (k8s dev)') {
            steps {
                script {
                    if (!devUp()) {
                        unstable('srvk8sdev is unreachable — dev host cert renewal skipped')
                        return
                    }
                    int rc = sh(
                        returnStatus: true,
                        script: '''
                            iac -c '
                                set -euo pipefail
                                cd /work/Ansible/ansible
                                timeout --kill-after=1m 10m ansible-playbook --diff playbooks/renew-host-certs.yml --limit k8s_dev
                            '
                        '''
                    )
                    if (rc != 0) {
                        String message = "dev host cert renewal failed on srvk8sdev (exit ${rc})"
                        notify.warning(message)
                        unstable(message)
                    }
                }
            }
        }

        // A lapsed leaf breaks the Proxmox web UI, the kubernetes-api.home SNI path and the
        // OpenBao listener, so this fails the build and pages too.
        //
        // The playbook renews every pveproxy and OpenBao host it can, then the k8s leaves one node
        // at a time, stopping at the first k8s node that fails, so a node not ready after its
        // kubelite restart never lets the next one go down. Either way the stage reds when the run
        // ends, not at the first bad host.
        //
        // No shell bound: each prd control-plane node's kubelite restart waits up to
        // microk8s_kubelite_ready_timeout (180s), one node at a time, so a run with all three k8s
        // leaves due spends ~9 minutes in handlers alone. A bound sized on the host-cert stage
        // would kill such a run mid-roll, leaving a node's kubelite down.
        stage('Renew TLS leaves (excl. k8s dev)') {
            steps {
                script {
                    prdStage('internal_tls leaves may lapse', '''
                        iac -c '
                            set -euo pipefail
                            cd /work/Ansible/ansible
                            ansible-playbook --diff playbooks/renew-internal-tls.yml --limit "!k8s_dev"
                        '
                    ''')
                }
            }
        }

        // The operator picks a missed dev leaf up by hand with an apply; this job does not carry
        // it forward or retry it. 15m bound: one node, one leaf, and a kubelite restart that waits
        // up to 180s for this node to be ready again.
        stage('Renew TLS leaves (k8s dev)') {
            steps {
                script {
                    if (!devUp()) {
                        unstable('srvk8sdev is unreachable — dev TLS leaf renewal skipped')
                        return
                    }
                    int rc = sh(
                        returnStatus: true,
                        script: '''
                            iac -c '
                                set -euo pipefail
                                cd /work/Ansible/ansible
                                timeout --kill-after=1m 15m ansible-playbook --diff playbooks/renew-internal-tls.yml --limit k8s_dev
                            '
                        '''
                    )
                    if (rc != 0) {
                        String message = "dev TLS leaf renewal failed on srvk8sdev (exit ${rc})"
                        notify.warning(message)
                        unstable(message)
                    }
                }
            }
        }
    }

    post {
        aborted {
            script {
                notify.error("${env.JOB_NAME} #${env.BUILD_NUMBER} aborted (timeout or hand)")
            }
        }
    }
}
