#!/bin/bash
# openbao-backup — daily leader-guarded backup to the homelab
# backup-server. Managed by the openbao Ansible role; do not edit.
#
# Produces one .tgz per run:
#   raft.snap      — native Raft snapshot; the atomic restore artifact
#   kv.json        — plaintext KV-v2 tree; break-glass reads + inspection
#   policies.json  — ACL policy catalogue (name -> HCL text)
#   auth.json      — auth method config
#   mounts.json    — secret mount config
#   manifest.json  — export timestamp, host, OpenBao version
#
# Followers exit 0 immediately; only the Raft leader produces a bundle.
# Any failure exits non-zero so the systemd unit is marked failed and
# surfaces in `systemctl --failed`. A failed call logs its method, path,
# HTTP status and OpenBao's error strings, never a response body: the
# login, snapshot, KV and policy responses carry secret material.
set -euo pipefail

OPENBAO_ADDR="{{ openbao_api_addr }}"
KV_MOUNT="{{ openbao_kv_mount }}"
BACKUP_SERVER_URL="{{ openbao_backup_server_url }}"
ROLE_ID_FILE="{{ openbao_config_dir }}/backup-role-id"
SECRET_ID_FILE="{{ openbao_config_dir }}/backup-secret-id"
UPLOAD_TOKEN_FILE="{{ openbao_config_dir }}/backup-token"
UPLOAD_FILENAME="openbao-backup.tgz"

log() { echo "openbao-backup: $*"; }

work=$(mktemp -d /dev/shm/openbao-backup.XXXXXX)
trap 'rm -rf "${work}"' EXIT
resp="${work}/response"

# request NAME OUT CURL_ARG... — one HTTP call: the body to OUT, the
# status to ${http}. A call without a complete response ends the run.
http=""
request() {
  local name="$1" out="$2" rc=0
  shift 2
  http=$(curl -sS -o "${out}" -w '%{http_code}' "$@") || rc=$?
  if (( rc == 0 )); then
    return 0
  elif [[ "${http}" == "000" ]]; then
    log "${name} failed: no HTTP response (curl exit ${rc})" >&2
  else
    log "${name} failed: HTTP ${http}, then curl exit ${rc}" >&2
  fi
  exit 1
}

# bao_request METHOD PATH OUT [CURL_ARG...] — one OpenBao API call.
bao_request() {
  local method="$1" path="$2" out="$3"
  shift 3
  request "${method} ${path}" "${out}" -X "${method}" "$@" \
    "${OPENBAO_ADDR}/v1/${path}"
}

# bao_check METHOD PATH OUT — ends the run unless the last call answered
# 2xx, logging the "errors" strings of OpenBao's error body in OUT.
bao_check() {
  local errors
  if [[ "${http}" == 2?? ]]; then
    return 0
  fi
  errors=$(jq -r '[(.errors? // [])[]? | strings | gsub("\\s+"; " ")
    | ltrimstr(" ") | rtrimstr(" ")] | join("; ")' "$3" 2>/dev/null) \
    || errors=""
  log "$1 $2 failed: HTTP ${http}${errors:+: ${errors}}" >&2
  exit 1
}

bao_api() { bao_request "$@"; bao_check "$1" "$2" "$3"; }

# --- leader guard (sys/leader is unauthenticated) -------------------
bao_api GET sys/leader "${resp}"
is_self=$(jq -r '.is_self' "${resp}")
if [[ "${is_self}" != "true" ]]; then
  log "not the Raft leader; nothing to do"
  exit 0
fi

# --- authenticate via the backup AppRole ----------------------------
login_body=$(jq -n --arg r "$(< "${ROLE_ID_FILE}")" \
  --arg s "$(< "${SECRET_ID_FILE}")" '{role_id: $r, secret_id: $s}')
bao_api POST auth/approle/login "${resp}" \
  -H 'Content-Type: application/json' -d "${login_body}"
token=$(jq -r '.auth.client_token' "${resp}")
if [[ -z "${token}" || "${token}" == "null" ]]; then
  log "POST auth/approle/login returned no token" >&2
  exit 1
fi
auth=(-H "X-Vault-Token: ${token}")

# --- the restore artifact: native Raft snapshot ---------------------
bao_api GET sys/storage/raft/snapshot "${work}/raft.snap" "${auth[@]}"

# --- collect ACL policies (name -> HCL text) ------------------------
policies='{}'
bao_api LIST sys/policies/acl "${resp}" "${auth[@]}"
policy_names=$(jq -r '(.data.keys // [])[]' "${resp}")
while IFS= read -r name; do
  [[ -n "${name}" ]] || continue
  bao_api GET "sys/policies/acl/${name}" "${resp}" "${auth[@]}"
  hcl=$(jq -r '.data.policy // ""' "${resp}")
  policies=$(jq -n --argjson o "${policies}" --arg n "${name}" \
    --arg p "${hcl}" '$o + {($n): $p}')
done <<< "${policy_names}"
printf '%s\n' "${policies}" > "${work}/policies.json"

# --- collect the KV-v2 tree (path -> secret data) -------------------
# An empty metadata path lists as 404; the walk treats that as "no
# keys here" so a freshly-mounted, still-empty kv/ is not an error.
kv='{}'
kv_walk() {
  local prefix="$1" keys key
  bao_request LIST "${KV_MOUNT}/metadata/${prefix}" "${resp}" "${auth[@]}"
  if [[ "${http}" == "404" ]]; then
    return 0
  fi
  bao_check LIST "${KV_MOUNT}/metadata/${prefix}" "${resp}"
  keys=$(jq -r '(.data.keys // [])[]' "${resp}")
  while IFS= read -r key; do
    [[ -n "${key}" ]] || continue
    if [[ "${key}" == */ ]]; then
      kv_walk "${prefix}${key}"
    else
      bao_api GET "${KV_MOUNT}/data/${prefix}${key}" "${resp}" "${auth[@]}"
      kv=$(jq --argjson o "${kv}" --arg p "${prefix}${key}" \
        '$o + {($p): .data.data}' "${resp}")
    fi
  done <<< "${keys}"
}
kv_walk ""
printf '%s\n' "${kv}" > "${work}/kv.json"

# --- auth + mount config --------------------------------------------
bao_api GET sys/auth "${resp}" "${auth[@]}"
jq '.data' "${resp}" > "${work}/auth.json"
bao_api GET sys/mounts "${resp}" "${auth[@]}"
jq '.data' "${resp}" > "${work}/mounts.json"

# --- manifest -------------------------------------------------------
jq -n \
  --arg ts "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
  --arg host "$(hostname -s)" \
  --arg ver "{{ openbao_version }}" \
  '{exported_at: $ts, exported_by: $host, openbao_version: $ver}' \
  > "${work}/manifest.json"

# --- bundle + upload ------------------------------------------------
tar czf "${work}/${UPLOAD_FILENAME}" -C "${work}" \
  manifest.json auth.json mounts.json policies.json kv.json raft.snap

# backup-server answers in plain text, so only the status is logged.
request "POST ${BACKUP_SERVER_URL}/upload" "${resp}" -X POST \
  -H "Authorization: Bearer $(< "${UPLOAD_TOKEN_FILE}")" \
  -H 'Content-Type: application/octet-stream' \
  --data-binary "@${work}/${UPLOAD_FILENAME}" \
  "${BACKUP_SERVER_URL}/upload?filename=${UPLOAD_FILENAME}"
if [[ "${http}" != 2?? ]]; then
  log "POST ${BACKUP_SERVER_URL}/upload failed: HTTP ${http}" >&2
  exit 1
fi

log "backup uploaded (snapshot $(stat -c %s "${work}/raft.snap") bytes, bundle $(stat -c %s "${work}/${UPLOAD_FILENAME}") bytes)"
