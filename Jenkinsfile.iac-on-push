// iac-on-push — validates every push to main on pvginkel/Ansible.
// Read-only: `terraform plan` plus the protected-VM destroy check. It
// converges nothing.
//
// The converging stages used to live here and fire on every push. They
// are now Jenkinsfile.iac-apply, started by hand. The split exists so
// that pushing a commit is not the same act as applying it to
// production — an unattended agent pushing a branch must not be able to
// roll the prd fleet. Whoever wants convergence starts iac-apply.
//
// A red build here means the commit on main would not apply cleanly, or
// would destroy something protected. Nothing has happened to the estate
// either way.
//
// Controller config:
//   - SCM: pvginkel/Ansible, branch main
//   - Script Path: Jenkinsfile.iac-on-push
//   - Build trigger: GitHub hook on pvginkel/Ansible main

pipeline {
    agent { label 'iac-controller' }

    options {
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '50'))
    }

    triggers {
        githubPush()
    }

    stages {
        stage('Plan + destroy check') {
            steps {
                sh '''
                    iac -c '
                        set -euo pipefail
                        cd /work/Ansible/terraform/prd
                        terraform init -input=false -no-color
                        rc=0
                        terraform plan -out=/tmp/plan.tfplan -no-color -detailed-exitcode || rc=$?
                        # POSIX test, not [[ ]]: iac -c runs the script under
                        # the iac image sh (dash), where [[ is "not found".
                        if [ "$rc" -ne 0 ] && [ "$rc" -ne 2 ]; then exit "$rc"; fi
                        terraform show -json /tmp/plan.tfplan > /tmp/plan.json
                        check-protected-vms.sh /tmp/plan.json srviac
                    '
                '''
            }
        }
    }

    // No post block: this pipeline has no dev stage, so it is only ever green
    // or red, and jenkins-telegram-bot watches every build and reports FAILURE
    // loudly by itself, job name and build link included.
}
