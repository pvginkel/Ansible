// iac-on-push — fires on every push to main on pvginkel/Ansible.
// Sequential, fail-fast on prd: plan + destroy-check, apply, site (sans
// iac_agent), site-openbao, site-k8s (prd). A trailing dev stage
// (srvk8sdev: site-k8s dev + site-ceph) is non-blocking on purpose —
// srvk8sdev is offline most of the time, so that stage probes
// reachability, fails fast, and reds its own stage without failing the
// build. Each stage wraps its work in a single `iac -c '...'` so the
// IaC mutex is held across the steps that must be atomic.
//
// All ansible stages run with `--skip-tags os_update`: apt cache
// refresh + dist-upgrade are patch posture, owned by
// iac-scheduled-update (today: update-k8s.yml; future: update-ceph).
// On-push converges config drift only; it never drains, upgrades, or
// reboots a cluster node. Same skip-tags pattern as
// iac-scheduled-drift.
//
// Controller config:
//   - SCM: pvginkel/Ansible, branch main
//   - Script Path: Jenkinsfile.iac-on-push
//   - Build trigger: GitHub hook on pvginkel/Ansible main

pipeline {
    agent { label 'iac-controller' }

    options {
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '50'))
    }

    triggers {
        githubPush()
    }

    stages {
        stage('Plan + destroy check') {
            steps {
                sh '''
                    iac -c '
                        set -euo pipefail
                        cd /work/Ansible/terraform/prd
                        terraform init -input=false -no-color
                        rc=0
                        terraform plan -out=/tmp/plan.tfplan -no-color -detailed-exitcode || rc=$?
                        if [[ $rc -ne 0 && $rc -ne 2 ]]; then exit $rc; fi
                        terraform show -json /tmp/plan.tfplan > /tmp/plan.json
                        check-protected-vms.sh /tmp/plan.json srviac
                    '
                '''
            }
        }

        stage('Terraform apply (prd)') {
            steps {
                sh '''
                    iac -c '
                        set -euo pipefail
                        cd /work/Ansible/terraform/prd
                        terraform init -input=false -no-color
                        terraform apply -auto-approve -no-color
                    '
                '''
            }
        }

        stage('Ansible site (excl. iac_agent)') {
            steps {
                sh '''
                    iac -c '
                        set -euo pipefail
                        cd /work/Ansible/ansible
                        ansible-playbook --diff playbooks/site.yml --limit "!iac_agent" --skip-tags os_update
                    '
                '''
            }
        }

        stage('Ansible site-openbao') {
            // site-openbao.yml converges the OpenBao service VMs;
            // site.yml excludes them because the Play 0 transient
            // known_hosts handoff (pre-cert SSH for srvvaultN) lives
            // here, not in site.yml. Play 0 reads `terraform output
            // host_pubkeys` and writes tmp/known_hosts.openbao at
            // run time, so this works from CI without operator
            // priming.
            steps {
                sh '''
                    iac -c '
                        set -euo pipefail
                        cd /work/Ansible/ansible
                        ansible-playbook --diff playbooks/site-openbao.yml --skip-tags os_update
                    '
                '''
            }
        }

        stage('Ansible site-k8s (prd)') {
            // Converges cluster config drift (baseline, microk8s,
            // ssh_host_cert) on the prd k8s cluster. site.yml excludes
            // the k8s groups because cluster changes need serial: 1, so
            // without this stage a microk8s role tweak wouldn't land on
            // push. Limited to k8s_prd — the dev node converges in the
            // non-blocking dev stage below (splitting the play by
            // cluster limit is safe: elect-primary elects per cluster).
            // --skip-tags os_update keeps the apt cache refresh +
            // dist-upgrade out — those belong to iac-scheduled-update /
            // update-k8s.yml, which owns the drain → upgrade → reboot
            // cycle.
            steps {
                sh '''
                    iac -c '
                        set -euo pipefail
                        cd /work/Ansible/ansible
                        ansible-playbook --diff playbooks/site-k8s.yml --limit k8s_prd --skip-tags os_update
                    '
                '''
            }
        }

        // srvk8sdev converges here, split off from the prd stage above
        // and made non-blocking on purpose: the dev box is powered off
        // most of the time. A bounded `ansible ... -m ping -T 5` fails
        // the stage in ~5s instead of letting the microk8s "wait for
        // API" retry loop burn ~2h, and catchError reds THIS stage while
        // keeping the build green — a red "(dev)" stage on a green build
        // reads at a glance as "dev was offline," not a regression. No
        // UNSTABLE, no page. timeout() bounds the rarer case where
        // srvk8sdev answers SSH but its API never comes up. Both dev
        // playbooks live here: site-k8s --limit k8s_dev (baseline +
        // microk8s on srvk8sdev) and site-ceph (its microceph layer,
        // ceph_dev → srvk8sdev only).
        stage('Ansible dev (srvk8sdev)') {
            steps {
                catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
                    timeout(time: 15, unit: 'MINUTES') {
                        sh '''
                            iac -c '
                                set -euo pipefail
                                cd /work/Ansible/ansible
                                ansible k8s_dev -m ping -o -T 5
                                ansible-playbook --diff playbooks/site-k8s.yml --limit k8s_dev --skip-tags os_update
                                ansible-playbook --diff playbooks/site-ceph.yml --skip-tags os_update
                            '
                        '''
                    }
                }
            }
        }
    }

    post {
        failure {
            sh '''iac -c 'send_message.py --title "iac-on-push #'"$BUILD_NUMBER"' failed" "'"$BUILD_URL"'"' '''
        }
    }
}
