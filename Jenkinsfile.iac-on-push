// Validates every push to main on pvginkel/Ansible: the lint and validate gates, then a Terraform
// plan of prd and the protected-VM destroy check. Its one change outside the build: when the push
// touched docs/runbooks/, it starts the Publish workflow of pvginkel/SOPs, whose site mirrors the
// runbooks, with the GitHub token kv/jenkins/sops-publish.
//
// Convergence is Jenkinsfile.iac-apply, started by hand, so that pushing a commit is not the same
// act as applying it to production: an unattended agent pushing a branch must not be able to roll
// the prd fleet. A red build means the commit on main fails a lint or validate gate, would not
// apply cleanly, or would destroy something protected. Nothing has happened to the estate either
// way.
//
// Controller config:
//   - Job: IaC/Build-Main
//   - SCM: pvginkel/Ansible, branch main
//   - Script Path: Jenkinsfile.iac-on-push

library identifier: 'JenkinsPipelineUtils', changelog: false

pipeline {
    agent { label 'iac-controller' }

    options {
        // Without abortPrevious: this file carries the abort marker, which would page for every
        // build a newer push replaced.
        disableConcurrentBuilds()
        skipDefaultCheckout()
        timeout(time: 4, unit: 'HOURS')
        timestamps()
    }

    triggers {
        githubPush()
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        // The gates run cheapest first; a red gate stops the build before the plan. The commands
        // are the dev loop's gate (.kubecoder/project.yaml, projects `ansible` and `terraform`) and
        // must stay identical to it. ansible-lint takes strict mode and the mandatory-var
        // placeholders from .ansible-lint, and its unskippable syntax-check rule runs
        // `ansible-playbook --syntax-check` on every playbook.
        stage('Lint') {
            steps {
                sh '''
                    iac -c '
                        set -euo pipefail
                        cd /work/Ansible/terraform
                        terraform fmt -check -recursive
                        cd /work/Ansible/ansible
                        yamllint -c ../.yamllint .
                        ansible-lint
                    '
                '''
            }
        }

        // -backend=false: validate reads no state, so this gate never touches the state backend
        // or its lock.
        stage('Validate Terraform') {
            steps {
                sh '''
                    iac -c '
                        set -euo pipefail
                        for root in prd scratch; do
                            cd "/work/Ansible/terraform/$root"
                            terraform init -backend=false -input=false -no-color
                            terraform validate -no-color
                        done
                    '
                '''
            }
        }

        stage('Plan Terraform and check destroys (prd)') {
            steps {
                sh '''
                    iac -c '
                        set -euo pipefail
                        cd /work/Ansible/terraform/prd
                        terraform init -input=false -no-color
                        rc=0
                        terraform plan -out=/tmp/plan.tfplan -no-color -detailed-exitcode || rc=$?
                        # POSIX test, not [[ ]]: iac -c runs the script under
                        # the iac image sh (dash), where [[ is "not found".
                        if [ "$rc" -ne 0 ] && [ "$rc" -ne 2 ]; then exit "$rc"; fi
                        terraform show -json /tmp/plan.tfplan > /tmp/plan.json
                        check-protected-vms.sh /tmp/plan.json
                    '
                '''
            }
        }

        // After the gates, though the site mirrors main whatever they say: a red main is a commit
        // under repair, and the Publish workflow's daily run still catches it up.
        stage('Trigger Publish (SOPs)') {
            when {
                changeset 'docs/runbooks/**'
            }
            steps {
                withVault([vaultSecrets: [
                    [path: 'kv/jenkins/sops-publish', engineVersion: 2, secretValues: [
                        [envVar: 'GITHUB_TOKEN', vaultKey: 'token'],
                    ]],
                ]]) {
                    sh '''
                        curl -fsS -X POST \
                            -H "Authorization: Bearer $GITHUB_TOKEN" \
                            -H 'Accept: application/vnd.github+json' \
                            -H 'X-GitHub-Api-Version: 2022-11-28' \
                            -d '{"ref":"main"}' \
                            https://api.github.com/repos/pvginkel/SOPs/actions/workflows/pages.yml/dispatches
                    '''
                }
            }
        }
    }

    post {
        aborted {
            script {
                notify.error("${env.JOB_NAME} #${env.BUILD_NUMBER} aborted (timeout or hand)")
            }
        }
    }
}
