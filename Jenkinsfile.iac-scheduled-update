// iac-scheduled-update — weekly cluster-class OS maintenance.
// Idempotent: no-op when no upgrades are pending.
//
// Coverage is by host class (decisions.md "OS updates"), not by
// site-* playbook:
//   - Cluster class (k8s, ceph) is Ansible-orchestrated here.
//     update-k8s.yml runs today; update-ceph.yml is future work.
//   - Standalone class (Jenkins agent, srvvault1/2/3) self-updates
//     via unattended-upgrades in a quiet window — baseline installs
//     and configures the package, then steps back. No stage needed.
//   - Self-managed hosts sit outside this system entirely.
//
// Reboot stagger across the standalone fleet is enforced by their
// unattended-upgrades windows, not by anything in this pipeline.
//
// Controller config:
//   - SCM: pvginkel/Ansible, branch main
//   - Script Path: Jenkinsfile.iac-scheduled-update

library identifier: 'JenkinsPipelineUtils', changelog: false

// srvk8sdev is powered off most of the time. Every dev stage in every
// iac-* pipeline opens with this bounded SSH probe: `-T 5` caps the
// connect, so a down box costs seconds rather than a playbook's worth
// of connection retries. A false result means "skip the stage and mark
// the build UNSTABLE" — never FAILURE, and never a page.
def devUp() {
    return sh(
        returnStatus: true,
        script: '''
            iac -c '
                cd /work/Ansible/ansible
                ansible k8s_dev -m ping -T 5
            '
        '''
    ) == 0
}

pipeline {
    agent { label 'iac-controller' }

    triggers {
        // Weekly, early Sunday. Cron lives here, not in the controller's
        // job config: the drift job's schedule was configured only in the
        // UI, silently vanished in June 2026, and nobody noticed for five
        // weeks — long enough for the fleet's SSH host certs to lapse.
        // A schedule that isn't in git can disappear without a diff.
        cron('H 4 * * 0')
    }

    options {
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '50'))
    }

    stages {
        // Critical clusters: an unreachable member fails the build. The
        // playbook's preflight aborts before any cordon, so a hard fail
        // here never leaves a half-drained prod cluster.
        stage('k8s prd') {
            steps {
                sh '''
                    iac -c '
                        set -euo pipefail
                        cd /work/Ansible/ansible
                        ansible-playbook --diff playbooks/update-k8s.yml --limit k8s_prd
                    '
                '''
            }
        }

        // Non-critical dev roll, two-tier handling:
        //   - If srvk8sdev is unreachable (powered off / down), skip the
        //     roll and mark the build UNSTABLE. A down dev box is
        //     expected churn, so it's visible but never pages.
        //   - If it's up but the roll fails, downgrade to UNSTABLE too,
        //     so a dev hiccup never reds the prod roll above — but do
        //     page, because that one is a real failure.
        //
        // 45m bound: a full drain → upgrade → reboot on a single node
        // runs well inside that, and it caps the case where a wedged
        // mount stalls the drain for the rest of the night.
        stage('k8s dev') {
            steps {
                script {
                    if (!devUp()) {
                        unstable('srvk8sdev is unreachable — dev cluster roll skipped')
                        return
                    }
                    def rc = sh(
                        returnStatus: true,
                        script: '''
                            iac -c '
                                set -euo pipefail
                                cd /work/Ansible/ansible
                                timeout --kill-after=1m 45m ansible-playbook --diff playbooks/update-k8s.yml --limit k8s_dev
                            '
                        '''
                    )
                    if (rc != 0) {
                        env.DEV_STAGE_FAILED = 'true'
                        unstable("dev cluster roll failed on srvk8sdev (exit ${rc})")
                    }
                }
            }
        }
    }

    post {
        // No failure handler: jenkins-telegram-bot watches every build and
        // reports FAILURE loudly by itself, job name and build link included.
        // UNSTABLE it deliberately stays quiet about — an accepted warning is
        // exactly what unstable means — so a dev stage that genuinely broke
        // has to say so itself.
        unstable {
            // Page only when srvk8sdev was up and the roll genuinely
            // failed. An unreachable dev box yellows the build so it's
            // visible in Jenkins, but it isn't news.
            script {
                if (env.DEV_STAGE_FAILED == 'true') {
                    notify.warning('dev cluster roll failed on srvk8sdev')
                }
            }
        }
    }
}
