// Rolls OS updates through the k8s clusters every week: drains, upgrades and reboots each k8s prd
// node in turn, then srvk8sdev when it is up. A no-op when no upgrades are pending.
//
// Coverage is by host class (decisions.md "OS updates"), not by site-* playbook:
//   - Cluster class (k8s, ceph) is Ansible-orchestrated here. update-k8s.yml runs today;
//     update-ceph.yml is future work.
//   - Standalone class (Jenkins agent, srvvault1/2/3) self-updates via unattended-upgrades in
//     a quiet window: baseline installs and configures the package, then steps back. Their
//     reboot stagger comes from those windows, not from this job.
//   - Self-managed hosts sit outside this system entirely.
//
// Controller config:
//   - Job: IaC/Scheduled Update
//   - SCM: pvginkel/Ansible, branch main
//   - Script Path: Jenkinsfile.iac-scheduled-update

library identifier: 'JenkinsPipelineUtils', changelog: false

// srvk8sdev is off unless someone starts it by hand. `-T 5` caps the connect,
// so a down box costs seconds rather than a playbook's worth of connection retries.
def devUp() {
    return sh(
        returnStatus: true,
        script: '''
            iac -c '
                cd /work/Ansible/ansible
                ansible k8s_dev -m ping -T 5
            '
        '''
    ) == 0
}

pipeline {
    agent { label 'iac-controller' }

    options {
        // Without abortPrevious: an abort in the middle of a roll leaves a node drained or half
        // upgraded.
        disableConcurrentBuilds()
        skipDefaultCheckout()
        timeout(time: 4, unit: 'HOURS')
        timestamps()
    }

    triggers {
        // Sunday early morning: the Wednesday calico rollout and the Friday certificate renewal
        // are scheduled clear of it.
        cron('H 4 * * 0')
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        // An unreachable member fails the build. The playbook's preflight aborts before any
        // cordon, so a failure here never leaves a half-drained prd cluster.
        stage('Roll OS updates (k8s prd)') {
            steps {
                sh '''
                    iac -c '
                        set -euo pipefail
                        cd /work/Ansible/ansible
                        ansible-playbook --diff playbooks/update-k8s.yml --limit k8s_prd
                    '
                '''
            }
        }

        // 45m bound: a full drain, upgrade and reboot of a single node runs well inside it, and it
        // caps the case where a wedged mount stalls the drain for the rest of the night.
        stage('Roll OS updates (k8s dev)') {
            steps {
                script {
                    if (!devUp()) {
                        unstable('srvk8sdev is unreachable — dev cluster roll skipped')
                        return
                    }
                    int rc = sh(
                        returnStatus: true,
                        script: '''
                            iac -c '
                                set -euo pipefail
                                cd /work/Ansible/ansible
                                timeout --kill-after=1m 45m ansible-playbook --diff playbooks/update-k8s.yml --limit k8s_dev
                            '
                        '''
                    )
                    if (rc != 0) {
                        String message = "dev cluster roll failed on srvk8sdev (exit ${rc})"
                        notify.warning(message)
                        unstable(message)
                    }
                }
            }
        }
    }

    post {
        aborted {
            script {
                notify.error("${env.JOB_NAME} #${env.BUILD_NUMBER} aborted (timeout or hand)")
            }
        }
    }
}
