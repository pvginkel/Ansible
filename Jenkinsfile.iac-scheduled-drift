// Checks every day that the estate matches the repo: a Terraform plan of prd, an Ansible --check
// of each site playbook, and step-ca's live roots against the in-repo homelab root. Read-only: no
// terraform apply, and no ansible run without --check.
//
// Every stage runs whatever an earlier one did, so a failure in one does not mask findings in the
// others. All stages are inside the same build, so however many of them fail, the build goes red
// once and is reported once.
//
// Controller config:
//   - Job: IaC/Scheduled Drift
//   - SCM: pvginkel/Ansible, branch main
//   - Script Path: Jenkinsfile.iac-scheduled-drift

library identifier: 'JenkinsPipelineUtils', changelog: false

// srvk8sdev is off unless someone starts it by hand. `-T 5` caps the connect,
// so a down box costs seconds rather than a playbook's worth of connection retries.
def devUp() {
    return sh(
        returnStatus: true,
        script: '''
            iac -c '
                cd /work/Ansible/ansible
                ansible k8s_dev -m ping -T 5
            '
        '''
    ) == 0
}

// Certificate renewal is IaC/Scheduled Certs' job, not this one's. That job re-issues any leaf
// inside its last 14 days and runs weekly, so a leaf that is merely inside that window is nothing
// for an operator to act on: Friday will sign it. Checked at the role's own 14 days, this build
// would go red for up to six days per leaf per cycle over renewals that need no hand, which is how
// a drift signal stops being read.
//
// So every stage that reaches a leaf checks one renewer period shorter: a leaf with under 7 days
// left is one the certs job has already had its Friday at and missed, and that is the only
// certificate state worth a red build here. Keep this at the role's threshold minus the certs
// job's period if either moves.
//
// ssh_host_cert is not listed: its sign step is a `command` with no check-mode report, so under
// --check it is skipped, not counted, and there is nothing here to shorten. The certs job's own
// build is the only signal for a host cert renewal that stopped happening.
def certDriftArgs = '-e internal_tls_renewal_threshold_days=7'

// What drifted is otherwise only in a log thousands of lines long. So every check tees its output
// to drift-logs/<name>.log, and a check that goes wrong records the lines naming the drift in the
// build description: jenkins-telegram-bot appends that to its FAILURE message, and a dev stage's
// warning carries its own entry.
//
// The tee is why every check's script opens with a bash shebang: the pipe needs pipefail, or the
// step would report tee's status instead of the check's. (iac is itself a bash script on this
// agent.)

// Pulls the lines that name the drift out of a check's teed output:
//   terraform  first each VM destroy Terraform refused (prevent_destroy)
//              and each of check-protected-vms' verdicts, then each
//              resource header of the plan ("<address> will be updated
//              in-place"), or the Error: lines when the plan itself broke
//   ansible    each task that came back changed, failed or unreachable,
//              as "<host>: <role : task> (<what>)"
//   otherwise  the stage's own DRIFT: lines
// Falls back to the last lines of output when nothing matches (an iac
// that failed to start, a broken init), and caps the list so a
// sweeping change still reads as a message.
@NonCPS
String driftSummary(String output, String tool) {
    def verdicts = new LinkedHashSet<String>()
    def items = new LinkedHashSet<String>()
    def errors = new LinkedHashSet<String>()
    String task = null
    String[] outputLines = output.split('\n')
    for (String line : outputLines) {
        def m
        if (tool == 'terraform') {
            if ((m = line =~ /^\s*# (\S+ (?:is tainted, so )?(?:will|must) be .+)$/)) {
                items << m.group(1)
            } else if ((m = line =~ /^check-protected-vms: (.+?):?$/)) {
                verdicts << m.group(1)
            } else if ((m = line =~ /^\W*Error: (.+)$/)) {
                errors << m.group(1)
            }
        } else if (tool == 'ansible') {
            if ((m = line =~ /^(?:TASK|RUNNING HANDLER) \[(.+)\] \**\s*$/)) {
                task = m.group(1)
            } else if ((m = line =~ /^(changed|fatal): \[([^\]]+)\](.*)$/)) {
                String what = 'changed'
                if (m.group(1) == 'fatal') {
                    what = m.group(3).contains('UNREACHABLE!') ? 'unreachable' : 'failed'
                }
                items << "${m.group(2)}: ${task} (${what})".toString()
            } else if ((m = line =~ /^(?:\[ERROR\]: |ERROR! )(.+)$/)) {
                errors << m.group(1)
            }
        } else if ((m = line =~ /^DRIFT: (.+)$/)) {
            items << m.group(1)
        }
    }

    // List literals, not `new ArrayList`: the sandbox rejects that
    // constructor without a script approval held in Jenkins, and losing
    // the approval turned every drift run red.
    List<String> lines = []
    if (tool == 'terraform') {
        // A refused plan still renders its body, so the refused VM's
        // header alone reads as drift. The diagnostic wraps at 78 columns,
        // splitting a long address from "Resource" and "has".
        def refusal = output =~ /Resource\s+(\S+)\s+has\s+lifecycle\.prevent_destroy\s+set/
        while (refusal.find()) {
            lines.add("Terraform refused to destroy ${refusal.group(1)} (prevent_destroy)".toString())
        }
    }
    lines.addAll(verdicts)
    lines.addAll(items ?: errors)
    if (lines.isEmpty()) {
        for (String line : outputLines) {
            if (line.trim()) {
                lines.add(line.trim())
            }
        }
        lines = lines.subList(Math.max(0, lines.size() - 3), lines.size())
    }
    if (lines.isEmpty()) {
        return 'no output captured; see the build log'
    }
    int max = 10
    List<String> shown = []
    shown.addAll(lines.subList(0, Math.min(max, lines.size())))
    if (lines.size() > max) {
        shown << "… and ${lines.size() - max} more in the build log".toString()
    }
    return shown.join('\n')
}

// Records a check that went wrong in the build description, under its
// stage name, and returns that entry. Appends rather than overwrites, so
// every failed check's entry survives.
def recordDrift(String stage, String log, String tool) {
    def path = "drift-logs/${log}.log"
    def output = fileExists(path) ? readFile(path) : ''
    def entry = "${stage}:\n${driftSummary(output, tool)}".toString()
    if (currentBuild.description) {
        currentBuild.description = "${currentBuild.description}\n\n${entry}".toString()
    } else {
        currentBuild.description = entry
    }
    return entry
}

// Runs a prd check. jenkins-telegram-bot reports a FAILURE by itself, with the build description
// on the lines under it, so a check that fails records its drift, then marks its stage and the
// build FAILURE without throwing, so the checks after it still run. The sh stays outside
// catchError: an abort or a timeout() caught inside it sets the build ABORTED whatever buildResult
// says (IaC/Apply build #113).
def prdCheck(String stage, String log, String tool, String shellScript) {
    int rc = sh(returnStatus: true, script: shellScript)
    if (rc != 0) {
        recordDrift(stage, log, tool)
        catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
            error("${stage} reported drift or failed (exit ${rc})")
        }
    }
}

pipeline {
    agent { label 'iac-controller' }

    options {
        // Without abortPrevious: this file carries the abort marker, which would page for every
        // build a newer one replaced.
        disableConcurrentBuilds()
        skipDefaultCheckout()
        timeout(time: 4, unit: 'HOURS')
        timestamps()
    }

    triggers {
        // Daily, late morning.
        cron('H 11 * * *')
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Check Terraform drift (prd)') {
            steps {
                script {
                    prdCheck('Check Terraform drift (prd)', 'tf-prd', 'terraform', '''#!/usr/bin/env bash
                        set -o pipefail
                        mkdir -p drift-logs
                        iac -c '
                            set -euo pipefail
                            cd /work/Ansible/terraform/prd
                            terraform init -input=false -no-color
                            rc=0
                            terraform plan -out=/tmp/plan.tfplan -no-color -detailed-exitcode || rc=$?
                            # POSIX test, not [[ ]]: iac -c runs the script under
                            # the iac image sh (dash), where [[ is "not found".
                            if [ "$rc" -eq 0 ]; then
                                exit 0
                            elif [ "$rc" -eq 2 ]; then
                                terraform show -json /tmp/plan.tfplan > /tmp/plan.json
                                check-protected-vms.sh /tmp/plan.json
                                check-terraform-drift.sh /tmp/plan.json
                            else
                                exit $rc
                            fi
                        ' 2>&1 | tee drift-logs/tf-prd.log
                    ''')
                }
            }
        }

        // --skip-tags os_update: the apt cache refresh and dist-upgrade tasks in baseline report
        // pending package upgrades as `changed` under --check. That is patch posture, not drift;
        // IaC/Scheduled Update applies it. Drop the skip once those tasks leave site.yml (see
        // decisions.md "OS updates").
        //
        // srviac is checked too. IaC/Apply leaves it out because the orchestrator must not change
        // the host it runs on, but --check never changes a host.
        stage('Check Ansible drift (site)') {
            steps {
                script {
                    prdCheck('Check Ansible drift (site)', 'site', 'ansible', """#!/usr/bin/env bash
                        set -o pipefail
                        mkdir -p drift-logs
                        iac -c '
                            set -euo pipefail
                            cd /work/Ansible/ansible
                            check-ansible-drift.sh playbooks/site.yml --skip-tags os_update ${certDriftArgs}
                        ' 2>&1 | tee drift-logs/site.log
                    """)
                }
            }
        }

        // site.yml excludes the k8s clusters (serial: 1 and drain concerns), so without this stage
        // a k8s config change is invisible to CI. The dev node is checked in a stage of its own.
        stage('Check Ansible drift (k8s prd)') {
            steps {
                script {
                    prdCheck('Check Ansible drift (k8s prd)', 'k8s-prd', 'ansible', """#!/usr/bin/env bash
                        set -o pipefail
                        mkdir -p drift-logs
                        iac -c '
                            set -euo pipefail
                            cd /work/Ansible/ansible
                            check-ansible-drift.sh playbooks/site-k8s.yml --limit k8s_prd --skip-tags os_update ${certDriftArgs}
                        ' 2>&1 | tee drift-logs/k8s-prd.log
                    """)
                }
            }
        }

        // srvk8sdev is offline most of the time. Dev drift is worth seeing but not worth reddening
        // a build whose whole prd surface came back clean, and the daily cadence would otherwise
        // page every day a dev box is left off.
        stage('Check Ansible drift (k8s dev)') {
            steps {
                script {
                    if (!devUp()) {
                        unstable('srvk8sdev is unreachable — dev k8s drift check skipped')
                        return
                    }
                    int rc = sh(
                        returnStatus: true,
                        script: """#!/usr/bin/env bash
                            set -o pipefail
                            mkdir -p drift-logs
                            iac -c '
                                set -euo pipefail
                                cd /work/Ansible/ansible
                                timeout --kill-after=1m 15m check-ansible-drift.sh playbooks/site-k8s.yml --limit k8s_dev --skip-tags os_update ${certDriftArgs}
                            ' 2>&1 | tee drift-logs/k8s-dev.log
                        """
                    )
                    if (rc != 0) {
                        String entry = recordDrift('Check Ansible drift (k8s dev)', 'k8s-dev', 'ansible')
                        String message = "dev k8s drift check reported changes or failed on srvk8sdev (exit ${rc})\n\n${entry}"
                        notify.warning(message)
                        unstable(message)
                    }
                }
            }
        }

        // site.yml excludes the OpenBao service VMs, whose pre-cert known_hosts handoff lives in
        // site-openbao.yml's Play 0, so an openbao config change is invisible to the site.yml
        // check.
        stage('Check Ansible drift (openbao)') {
            steps {
                script {
                    prdCheck('Check Ansible drift (openbao)', 'openbao', 'ansible', """#!/usr/bin/env bash
                        set -o pipefail
                        mkdir -p drift-logs
                        iac -c '
                            set -euo pipefail
                            cd /work/Ansible/ansible
                            check-ansible-drift.sh playbooks/site-openbao.yml --skip-tags os_update ${certDriftArgs}
                        ' 2>&1 | tee drift-logs/openbao.log
                    """)
                }
            }
        }

        // site-ceph.yml converges the microceph storage layer (today only ceph_dev, srvk8sdev);
        // site.yml and site-k8s.yml do not cover it. srvk8sdev-only, so it is handled as the k8s
        // dev stage is.
        stage('Check Ansible drift (ceph dev)') {
            steps {
                script {
                    if (!devUp()) {
                        unstable('srvk8sdev is unreachable — dev ceph drift check skipped')
                        return
                    }
                    int rc = sh(
                        returnStatus: true,
                        script: '''#!/usr/bin/env bash
                            set -o pipefail
                            mkdir -p drift-logs
                            iac -c '
                                set -euo pipefail
                                cd /work/Ansible/ansible
                                timeout --kill-after=1m 15m check-ansible-drift.sh playbooks/site-ceph.yml --skip-tags os_update
                            ' 2>&1 | tee drift-logs/ceph-dev.log
                        '''
                    )
                    if (rc != 0) {
                        String entry = recordDrift('Check Ansible drift (ceph dev)', 'ceph-dev', 'ansible')
                        String message = "dev ceph drift check reported changes or failed on srvk8sdev (exit ${rc})\n\n${entry}"
                        notify.warning(message)
                        unstable(message)
                    }
                }
            }
        }

        // The in-repo homelab-root.crt is the trust anchor baseline distributes to every managed
        // host. step-ca serves the live set of configured roots at https://ca.home/roots.pem; if
        // those disagree, either the CA was rotated without updating the repo or the repo copy was
        // edited without rotating the CA. --cacert pins the TLS handshake to the in-repo root, so
        // this also catches ca.home's leaf re-issued under a root the repo does not yet trust
        // (curl exits non-zero before the body is read).
        stage('Check homelab CA root drift') {
            steps {
                script {
                    prdCheck('Check homelab CA root drift', 'ca-root', 'plain', '''#!/usr/bin/env bash
                        set -o pipefail
                        mkdir -p drift-logs
                        iac -c '
                            set -euo pipefail
                            cd /work/Ansible
                            expected=ansible/roles/baseline/files/homelab-root.crt
                            tmp=$(mktemp)
                            trap "rm -f $tmp" EXIT
                            if ! curl --cacert "$expected" --silent --fail --show-error \
                                    https://ca.home/roots.pem -o "$tmp"; then
                                echo "DRIFT: could not fetch https://ca.home/roots.pem with the in-repo root as the trust anchor — CA may have been rotated" >&2
                                exit 1
                            fi
                            if ! diff -u "$expected" "$tmp"; then
                                echo "DRIFT: https://ca.home/roots.pem differs from $expected" >&2
                                exit 1
                            fi
                        ' 2>&1 | tee drift-logs/ca-root.log
                    ''')
                }
            }
        }
    }

    post {
        aborted {
            script {
                notify.error("${env.JOB_NAME} #${env.BUILD_NUMBER} aborted (timeout or hand)")
            }
        }
    }
}
