// iac-scheduled-drift — daily drift check across terraform + ansible.
// Push-notifies on detected changes or non-zero exit. Read-only; no
// terraform apply, no ansible run without --check.
//
// Stages run sequentially so a failure in one doesn't mask findings
// in the others. All stages are inside the same Jenkins build, so
// however many of them fail, the build goes red once and is reported
// once.
//
// Controller config:
//   - SCM: pvginkel/Ansible, branch main
//   - Script Path: Jenkinsfile.iac-scheduled-drift

library identifier: 'JenkinsPipelineUtils', changelog: false

// srvk8sdev is powered off most of the time. Every dev stage in every
// iac-* pipeline opens with this bounded SSH probe: `-T 5` caps the
// connect, so a down box costs seconds rather than a playbook's worth
// of connection retries. A false result means "skip the stage and mark
// the build UNSTABLE" — never FAILURE, and never a page.
def devUp() {
    return sh(
        returnStatus: true,
        script: '''
            iac -c '
                cd /work/Ansible/ansible
                ansible k8s_dev -m ping -T 5
            '
        '''
    ) == 0
}

// Certificate renewal is iac-scheduled-certs' job, not this one's. That
// job re-issues any leaf inside its last 14 days and runs weekly, so a
// leaf that is merely inside that window is nothing for an operator to
// act on — Friday will sign it. Checked at the role's own 14 days, this
// build went red for up to six days per leaf per cycle over renewals
// that needed no hand, which is how a drift signal stops being read.
//
// So every stage that reaches a leaf checks one renewer period shorter:
// a leaf with under 7 days left is one the certs job has already had
// its Friday at and missed, and that is the only certificate state
// worth a red build here. Keep this at the role's threshold minus the
// certs job's period if either moves.
//
// ssh_host_cert is not listed: its sign step is a `command` with no
// check-mode report, so under --check it is skipped, not counted, and
// there is nothing here to shorten. The certs job's own build is the
// only signal for a host cert renewal that stopped happening.
def certDriftArgs = '-e internal_tls_renewal_threshold_days=7'

// A red build used to reach Telegram as a bare "Scheduled Drift #N",
// and what had drifted was only in a log thousands of lines long. So
// every check tees its output to drift-logs/<name>.log, and a check that
// goes wrong records the lines naming the drift in the build
// description: jenkins-telegram-bot appends that to its FAILURE
// message, and the dev stages' UNSTABLE warning carries it too.
//
// The tee is why every check's script opens with a bash shebang: the
// pipe needs pipefail, or the step would report tee's status instead
// of the check's. (iac is itself a bash script on this agent.)

// Pulls the lines that name the drift out of a check's teed output:
//   terraform  first each VM destroy Terraform refused (prevent_destroy)
//              and each of check-protected-vms' verdicts, then each
//              resource header of the plan ("<address> will be updated
//              in-place"), or the Error: lines when the plan itself broke
//   ansible    each task that came back changed, failed or unreachable,
//              as "<host>: <role : task> (<what>)"
//   otherwise  the stage's own DRIFT: lines
// Falls back to the last lines of output when nothing matches (an iac
// that failed to start, a broken init), and caps the list so a
// sweeping change still reads as a message.
@NonCPS
String driftSummary(String output, String tool) {
    def verdicts = new LinkedHashSet<String>()
    def items = new LinkedHashSet<String>()
    def errors = new LinkedHashSet<String>()
    String task = null
    String[] outputLines = output.split('\n')
    for (String line : outputLines) {
        def m
        if (tool == 'terraform') {
            if ((m = line =~ /^\s*# (\S+ (?:is tainted, so )?(?:will|must) be .+)$/)) {
                items << m.group(1)
            } else if ((m = line =~ /^check-protected-vms: (.+?):?$/)) {
                verdicts << m.group(1)
            } else if ((m = line =~ /^\W*Error: (.+)$/)) {
                errors << m.group(1)
            }
        } else if (tool == 'ansible') {
            if ((m = line =~ /^(?:TASK|RUNNING HANDLER) \[(.+)\] \**\s*$/)) {
                task = m.group(1)
            } else if ((m = line =~ /^(changed|fatal): \[([^\]]+)\](.*)$/)) {
                String what = 'changed'
                if (m.group(1) == 'fatal') {
                    what = m.group(3).contains('UNREACHABLE!') ? 'unreachable' : 'failed'
                }
                items << "${m.group(2)}: ${task} (${what})".toString()
            } else if ((m = line =~ /^(?:\[ERROR\]: |ERROR! )(.+)$/)) {
                errors << m.group(1)
            }
        } else if ((m = line =~ /^DRIFT: (.+)$/)) {
            items << m.group(1)
        }
    }

    List<String> lines = new ArrayList<String>()
    if (tool == 'terraform') {
        // A refused plan still renders its body, so the refused VM's
        // header alone reads as drift. The diagnostic wraps at 78 columns,
        // splitting a long address from "Resource" and "has".
        def refusal = output =~ /Resource\s+(\S+)\s+has\s+lifecycle\.prevent_destroy\s+set/
        while (refusal.find()) {
            lines.add("Terraform refused to destroy ${refusal.group(1)} (prevent_destroy)".toString())
        }
    }
    lines.addAll(verdicts)
    lines.addAll(items ?: errors)
    if (lines.isEmpty()) {
        for (String line : outputLines) {
            if (line.trim()) {
                lines.add(line.trim())
            }
        }
        lines = lines.subList(Math.max(0, lines.size() - 3), lines.size())
    }
    if (lines.isEmpty()) {
        return 'no output captured; see the build log'
    }
    int max = 10
    List<String> shown = new ArrayList<String>(lines.subList(0, Math.min(max, lines.size())))
    if (lines.size() > max) {
        shown << "… and ${lines.size() - max} more in the build log".toString()
    }
    return shown.join('\n')
}

// Records a check that went wrong in the build description, under its
// stage name. Appends rather than overwrites: a dev stage can record its
// drift before a later prd stage fails.
def recordDrift(String stage, String log, String tool) {
    def path = "drift-logs/${log}.log"
    def output = fileExists(path) ? readFile(path) : ''
    def entry = "${stage}:\n${driftSummary(output, tool)}".toString()
    if (currentBuild.description) {
        currentBuild.description = "${currentBuild.description}\n\n${entry}".toString()
    } else {
        currentBuild.description = entry
    }
}

pipeline {
    agent { label 'iac-controller' }

    triggers {
        // Daily, late morning. Cron lives here, not in the controller's
        // job config: this job's schedule was UI-only, disappeared in
        // June 2026 and went unnoticed for five weeks — which is how the
        // fleet's SSH host certificates were allowed to lapse unseen.
        // A schedule that isn't in git can disappear without a diff.
        cron('H 11 * * *')
    }

    options {
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '50'))
    }

    stages {
        stage('Terraform drift (prd)') {
            steps {
                sh '''#!/usr/bin/env bash
                    set -o pipefail
                    mkdir -p drift-logs
                    iac -c '
                        set -euo pipefail
                        cd /work/Ansible/terraform/prd
                        terraform init -input=false -no-color
                        rc=0
                        terraform plan -out=/tmp/plan.tfplan -no-color -detailed-exitcode || rc=$?
                        # POSIX test, not [[ ]]: iac -c runs the script under
                        # the iac image sh (dash), where [[ is "not found".
                        # Both branches used to fall through to the else, so a
                        # drifting plan exited 2 with no DRIFT line and no
                        # protected-VM check.
                        if [ "$rc" -eq 0 ]; then
                            exit 0
                        elif [ "$rc" -eq 2 ]; then
                            echo "DRIFT: terraform plan proposes changes against prd" >&2
                            terraform show -json /tmp/plan.tfplan > /tmp/plan.json
                            check-protected-vms.sh /tmp/plan.json
                            exit 1
                        else
                            exit $rc
                        fi
                    ' 2>&1 | tee drift-logs/tf-prd.log
                '''
            }
            post {
                failure {
                    script {
                        recordDrift('Terraform drift (prd)', 'tf-prd', 'terraform')
                    }
                }
            }
        }

        stage('Ansible drift (excl. iac_agent)') {
            steps {
                // --skip-tags os_update: the apt cache refresh and
                // dist-upgrade tasks in baseline report pending package
                // upgrades as `changed` under --check. That's patch
                // posture, not drift; the scheduled-update pipeline owns
                // applying it. Drop the skip once those tasks leave
                // site.yml (see decisions.md "OS updates").
                sh """#!/usr/bin/env bash
                    set -o pipefail
                    mkdir -p drift-logs
                    iac -c '
                        set -euo pipefail
                        cd /work/Ansible/ansible
                        check-ansible-drift.sh playbooks/site.yml --limit "!iac_agent" --skip-tags os_update ${certDriftArgs}
                    ' 2>&1 | tee drift-logs/site.log
                """
            }
            post {
                failure {
                    script {
                        recordDrift('Ansible drift (excl. iac_agent)', 'site', 'ansible')
                    }
                }
            }
        }

        stage('Ansible drift (k8s prd)') {
            steps {
                // site-k8s.yml converges the k8s clusters in place;
                // site.yml excludes them (serial: 1 / drain concerns),
                // so without this stage a k8s config change is invisible
                // to CI. Limited to k8s_prd; the dev node is gated below
                // (offline most of the time). --check only; same
                // --skip-tags os_update rationale as the stage above.
                sh """#!/usr/bin/env bash
                    set -o pipefail
                    mkdir -p drift-logs
                    iac -c '
                        set -euo pipefail
                        cd /work/Ansible/ansible
                        check-ansible-drift.sh playbooks/site-k8s.yml --limit k8s_prd --skip-tags os_update ${certDriftArgs}
                    ' 2>&1 | tee drift-logs/k8s-prd.log
                """
            }
            post {
                failure {
                    script {
                        recordDrift('Ansible drift (k8s prd)', 'k8s-prd', 'ansible')
                    }
                }
            }
        }

        // srvk8sdev is offline most of the time, so this stage skips on
        // an unreachable box and only ever marks the build UNSTABLE —
        // never FAILURE. Dev drift is worth seeing but is not worth
        // reddening a build whose whole prd surface came back clean, and
        // the daily cadence means a dev box left off would otherwise
        // page every single day.
        stage('Ansible drift (k8s dev)') {
            steps {
                script {
                    if (!devUp()) {
                        unstable('srvk8sdev is unreachable — dev k8s drift check skipped')
                        return
                    }
                    def rc = sh(
                        returnStatus: true,
                        script: """#!/usr/bin/env bash
                            set -o pipefail
                            mkdir -p drift-logs
                            iac -c '
                                set -euo pipefail
                                cd /work/Ansible/ansible
                                timeout --kill-after=1m 15m check-ansible-drift.sh playbooks/site-k8s.yml --limit k8s_dev --skip-tags os_update ${certDriftArgs}
                            ' 2>&1 | tee drift-logs/k8s-dev.log
                        """
                    )
                    if (rc != 0) {
                        env.DEV_STAGE_FAILED = 'true'
                        recordDrift('Ansible drift (k8s dev)', 'k8s-dev', 'ansible')
                        unstable("dev k8s drift check reported changes or failed (exit ${rc})")
                    }
                }
            }
        }

        stage('Ansible drift (openbao)') {
            steps {
                // site-openbao.yml converges the OpenBao service VMs;
                // site.yml excludes them so the pre-cert known_hosts
                // handoff lives in this playbook's Play 0. Same
                // rationale as the k8s stage above — an openbao config
                // change is invisible to site.yml drift, so this stage
                // covers it. --skip-tags os_update for the same patch-
                // posture reason.
                sh """#!/usr/bin/env bash
                    set -o pipefail
                    mkdir -p drift-logs
                    iac -c '
                        set -euo pipefail
                        cd /work/Ansible/ansible
                        check-ansible-drift.sh playbooks/site-openbao.yml --skip-tags os_update ${certDriftArgs}
                    ' 2>&1 | tee drift-logs/openbao.log
                """
            }
            post {
                failure {
                    script {
                        recordDrift('Ansible drift (openbao)', 'openbao', 'ansible')
                    }
                }
            }
        }

        // site-ceph.yml converges the microceph storage layer (today
        // only ceph_dev → srvk8sdev); site.yml and site-k8s.yml don't
        // cover it, so a microceph role or ceph_dev group_vars change is
        // invisible to drift without this stage. --check only; same
        // --skip-tags os_update belt as the stages above. Being
        // srvk8sdev-only it carries the same handling as the k8s dev
        // stage: skip when offline, UNSTABLE either way, never FAILURE.
        stage('Ansible drift (ceph dev)') {
            steps {
                script {
                    if (!devUp()) {
                        unstable('srvk8sdev is unreachable — dev ceph drift check skipped')
                        return
                    }
                    def rc = sh(
                        returnStatus: true,
                        script: '''#!/usr/bin/env bash
                            set -o pipefail
                            mkdir -p drift-logs
                            iac -c '
                                set -euo pipefail
                                cd /work/Ansible/ansible
                                timeout --kill-after=1m 15m check-ansible-drift.sh playbooks/site-ceph.yml --skip-tags os_update
                            ' 2>&1 | tee drift-logs/ceph-dev.log
                        '''
                    )
                    if (rc != 0) {
                        env.DEV_STAGE_FAILED = 'true'
                        recordDrift('Ansible drift (ceph dev)', 'ceph-dev', 'ansible')
                        unstable("dev ceph drift check reported changes or failed (exit ${rc})")
                    }
                }
            }
        }

        stage('Homelab CA root drift') {
            steps {
                // The in-repo homelab-root.crt is the trust anchor
                // baseline distributes to every managed host. step-ca
                // serves the live set of configured roots at
                // https://ca.home/roots.pem; if those disagree, either
                // the CA has been rotated without updating the repo or
                // the repo copy was edited without rotating the CA —
                // both are drift the operator wants to know about.
                //
                // --cacert pins the TLS handshake to the in-repo root,
                // so this also catches the case where ca.home's leaf
                // has been re-issued under a new root the repo does not
                // yet trust (curl exits non-zero before we ever read
                // the body).
                sh '''#!/usr/bin/env bash
                    set -o pipefail
                    mkdir -p drift-logs
                    iac -c '
                        set -euo pipefail
                        cd /work/Ansible
                        expected=ansible/roles/baseline/files/homelab-root.crt
                        tmp=$(mktemp)
                        trap "rm -f $tmp" EXIT
                        if ! curl --cacert "$expected" --silent --fail --show-error \
                                https://ca.home/roots.pem -o "$tmp"; then
                            echo "DRIFT: could not fetch https://ca.home/roots.pem with the in-repo root as the trust anchor — CA may have been rotated" >&2
                            exit 1
                        fi
                        if ! diff -u "$expected" "$tmp"; then
                            echo "DRIFT: https://ca.home/roots.pem differs from $expected" >&2
                            exit 1
                        fi
                    ' 2>&1 | tee drift-logs/ca-root.log
                '''
            }
            post {
                failure {
                    script {
                        recordDrift('Homelab CA root drift', 'ca-root', 'plain')
                    }
                }
            }
        }
    }

    post {
        // No failure handler: jenkins-telegram-bot watches every build and
        // reports FAILURE loudly by itself, job name and build link included,
        // with the build description (recordDrift) on the lines under it.
        // The old handler claimed "detected drift" on any red build, which
        // this job's own name says better and its failure modes contradict —
        // a host it could not reach fails it just as readily. UNSTABLE the bot
        // deliberately stays quiet about, so the dev stage says so itself.
        unstable {
            // Only the dev stages can make this build unstable. Page on
            // real dev drift; stay silent when srvk8sdev was simply off,
            // which on a daily job would otherwise be a daily false page.
            script {
                if (env.DEV_STAGE_FAILED == 'true') {
                    notify.warning("detected drift on srvk8sdev\n\n${currentBuild.description}")
                }
            }
        }
    }
}
