{
	"folders": [
		{
			"path": "."
		},
		{
			"path": "../AnsibleSpecs"
		},
		{
			"path": "../HelmCharts"
		},
		{
			"path": "../DockerImages"
		},
		{
			"path": "../IaCAgent"
		},
		{
			"path": "../HomelabTerraformProvider"
		}
	],
	"settings": {},
	"tasks": {
		"version": "2.0.0",
		"tasks": [
			{
				"label": "Claude",
				"type": "shell",
				"command": "kc session --ui --attach",
				"options": {
					"cwd": "/work"
				},
				"icon": { "id": "sparkle" },
				"problemMatcher": [],
				"presentation": {
					"panel": "new",
					"reveal": "always",
					"focus": true,
					"showReuseMessage": false,
					"close": true
				},
				"runOptions": {
					"reevaluateOnRerun": true,
					"instanceLimit": 999
				},
				"isBackground": true
			},
			{
				"label": "Build All",
				"type": "shell",
				"command": "kc project build",
				"options": {
					"cwd": "${workspaceFolder}"
				},
				"icon": { "id": "build" },
				"problemMatcher": [],
				"presentation": {
					"panel": "dedicated",
					"reveal": "always",
					"focus": true,
					"showReuseMessage": false
				}
			},
			{
				"label": "Test All",
				"type": "shell",
				"command": "kc project test",
				"options": {
					"cwd": "${workspaceFolder}"
				},
				"icon": { "id": "beaker" },
				"problemMatcher": [],
				"presentation": {
					"panel": "dedicated",
					"reveal": "always",
					"focus": true,
					"showReuseMessage": false
				}
			},
			{
				"label": "Lint All",
				"type": "shell",
				"command": "kc project lint",
				"options": {
					"cwd": "${workspaceFolder}"
				},
				"icon": { "id": "checklist" },
				"problemMatcher": [],
				"presentation": {
					"panel": "dedicated",
					"reveal": "always",
					"focus": true,
					"showReuseMessage": false
				}
			}
		]
	}
}
