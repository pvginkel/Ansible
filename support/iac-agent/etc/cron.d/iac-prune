# Daily prune of dangling Docker images. `prune -f` is dangling-only:
# it leaves the tagged inbound-agent image and the tagged
# registry:5000/iac image alone, even when they're not currently backing
# a container. `iac` runs `docker run --pull=always` on every call, and
# each refreshed pull of the single `:latest` tag untags the previous
# layer; this cron reclaims that disk.

SHELL=/bin/sh
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

0 4 * * * root /usr/bin/docker image prune -f >/dev/null 2>&1
