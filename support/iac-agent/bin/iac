#!/usr/bin/env bash
# `iac` — host shim. Acquire the IaC mutex, then run the configured
# iac-impl entrypoint inside the iac container. See
# /work/AnsibleSpecs/phases/iac-agent.md.
#
# Two forms:
#   iac                  interactive bash inside the container
#   iac -c '<script>'    run the script inside the container
#
# Both hold /var/lock/iac.lock via flock with a 60-second timeout. On
# contention the call fails fast; the holder PID is surfaced.

set -euo pipefail

IMAGE="${IAC_IMAGE:-registry:5000/iac:latest}"
LOCKFILE="/var/lock/iac.lock"
SECRETS_FILE="/etc/iac/secrets.yaml"
IAC_IMPL="/usr/local/bin/iac-impl"

# No host-side existence probe for $SECRETS_FILE — iac is often invoked
# from contexts (e.g. the Jenkins inbound-agent container) where that
# path isn't visible. The `--mount` below asks the docker daemon to
# bind it from the host, and the daemon errors loudly with "bind source
# path does not exist" if it's missing.

if [[ ! -x "$IAC_IMPL" ]]; then
    echo "iac: $IAC_IMPL missing — run IaCAgent's install.sh" >&2
    exit 1
fi

# --pull=always so every invocation refreshes against
# registry:5000/iac:latest before exec — the registry is a LAN-local
# insecure registry (daemon.json), so the metadata check is sub-second
# when the image is current, and we never run a stale cached copy
# missing changes baked into the rebuilt image.
#
# Add -it only when stdin is a tty (interactive shell case). Non-tty
# invocations (Jenkins stages, scripted ssh) skip it so docker doesn't
# fail allocating a pseudo-tty.
docker_flags=("--rm" "--pull=always" "--quiet")
if [[ -t 0 ]]; then
    docker_flags+=("-it")
fi

# fd 9 is the lock fd; flock returns 1 on timeout. Keep the fd open
# while docker runs so the lock is held for the whole invocation.
exec 9>"$LOCKFILE"
if ! flock -w 60 -x 9; then
    # The previous holder wrote its PID into the file when it acquired
    # the lock; read it for diagnostics. Best-effort — flock owns the
    # real interlock.
    holder=$(cat "$LOCKFILE" 2>/dev/null || true)
    echo "iac: could not acquire $LOCKFILE within 60s (held by PID ${holder:-unknown})" >&2
    exit 1
fi

# Record our PID for the next contender.
echo "$$" > "$LOCKFILE" 2>/dev/null || true

# send_message.py is bind-mounted so post-stage failure notifications
# from Jenkins (`iac -c 'send_message.py ...'`) work without baking
# the script into iac.
docker run "${docker_flags[@]}" \
    --mount "type=bind,source=$SECRETS_FILE,target=$SECRETS_FILE,readonly" \
    -v "$IAC_IMPL:/usr/local/bin/iac-impl:ro" \
    -v /usr/local/bin/send_message.py:/usr/local/bin/send_message.py:ro \
    -v /usr/local/bin/check-protected-vms.sh:/usr/local/bin/check-protected-vms.sh:ro \
    -v /usr/local/bin/check-ansible-drift.sh:/usr/local/bin/check-ansible-drift.sh:ro \
    "$IMAGE" \
    /usr/local/bin/iac-impl "$@"
