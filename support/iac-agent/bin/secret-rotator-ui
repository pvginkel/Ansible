#!/usr/bin/env bash
# `secret-rotator-ui` — SecretRotator's UI in the tmux session `secret-rotator`, started as
# `ssh -t ansible@srviac secret-rotator-ui`. Attaches to the session when it runs, and otherwise
# creates it running the UI. A lost SSH session leaves the UI running in the session; running this
# again reattaches to it instead of starting a second UI.
#
# set-clipboard on: the UI's Copy is an OSC 52 sequence, which tmux's default (`external`) drops.
# A UI that exits non-zero holds its output on screen until Enter, since the session closes with it.
# `sudo`: only pvginkel is in srviac's docker group.

set -euo pipefail

ui="sudo iac -c 'secret-rotator ui'"
hold='echo "secret-rotator ui exited with status $?. Enter closes the session."; read -r _'

exec tmux set-option -s set-clipboard on \; new-session -A -s secret-rotator "$ui || { $hold; }"
